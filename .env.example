# ============================================================
# 美发智能知识助手 - 配置模板
# 复制为 .env（开发）或 .env.prod（生产）并填入真实值
# ============================================================

# --- 环境标识 ---
# 可选值: dev / staging / prod
HAIRSTYLIST_ENV=dev

# --- 对话模型（火山方舟 OpenAI 兼容） ---
CHAT_API_KEY=your-api-key-here
CHAT_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
CHAT_MODEL=ep-xxxxxxxxx
CHAT_STREAM=1
CHAT_MAX_RETRIES=3
CHAT_TIMEOUT=60

# --- Embedding 嵌入模型 ---
EMBEDDING_API_KEY=your-api-key-here
EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/embeddings/multimodal
EMBEDDING_MODEL=doubao-embedding-vision-256
EMBEDDING_DIMENSIONS=2048

# --- Rerank 重排模型（可选） ---
RERANK_API_KEY=
RERANK_BASE_URL=
RERANK_MODEL=

# --- 向量库配置 ---
# 模式: local（本地文件，零Docker）/ memory（内存，测试用）/ remote（生产集群）
QDRANT_MODE=local
QDRANT_PATH=data/qdrant
QDRANT_URL=
QDRANT_API_KEY=
VECTOR_COLLECTION=hairstylist_kb
QDRANT_METRIC_TYPE=COSINE

# --- 服务端配置 ---
SERVER_HOST=127.0.0.1
SERVER_PORT=7860
SERVER_WORKERS=1
CORS_ORIGINS=*
RATE_LIMIT=100/minute

# --- 安全配置 ---
ENABLE_INPUT_FILTER=1
ENABLE_OUTPUT_FILTER=1
ENABLE_DOMAIN_BOUNDARY_CHECK=1
MAX_INPUT_LENGTH=500
MAX_OUTPUT_LENGTH=2000

# --- 日志与监控 ---
LOG_LEVEL=INFO
ENABLE_AUDIT_LOG=1
ENABLE_METRICS=1
METRICS_PORT=9090
LOG_RETENTION_DAYS=30
