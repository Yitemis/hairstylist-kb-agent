# ============================================================
# 美发智能知识助手 - 环境变量模板
# 复制为 .env 后填实际值 (不要提交 .env)
# ============================================================

# ---------- 服务基础 ----------
ENV=dev
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
CORS_ORIGINS=*
LOG_RETENTION_DAYS=30

# ---------- 数据库 (PG 含 pgvector 扩展) ----------
DATABASE_URL=postgresql+asyncpg://hair:hair123@localhost:5432/hairstylist

# ---------- Redis (缓存 + LTM) ----------
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_PREFIX=hairstylist
AGENT_STATE_BACKEND=redis                  # file / redis
AGENT_STATE_ROOT=./data/agent_state         # file 模式时生效
DEFAULT_TENANT_ID=demo                      # 业务租户 ID (chat_handler 缺省 tenant)

# ---------- Milvus (已弃用, 保留兼容) ----------
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_URI=localhost:19530
MILVUS_METRIC_TYPE=COSINE
MILVUS_TOKEN=

# ---------- 向量库 (默认 pgvector) ----------
VECTOR_STORE_ENGINE=pgvector               # pgvector (推荐) / milvus (弃用)
VECTOR_STORE_HOST=localhost
VECTOR_STORE_PORT=5432
VECTOR_STORE_API_KEY=
VECTOR_COLLECTION=hairstylist_kb           # 兼容字段, 实际用 child_chunks 表
VECTOR_DIMS=1024
VECTOR_METRIC_TYPE=COSINE

# ---------- 文本 Embedding (硅基流动) ----------
TEXT_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1/embeddings
TEXT_EMBEDDING_API_KEY=sk-your-siliconflow-key
TEXT_EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
TEXT_EMBEDDING_DIMENSIONS=1024

# ---------- 多模态 Embedding (火山方舟 multimodal, 已停用) ----------
MM_EMBEDDING_ENABLED=0
EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/embeddings/multimodal
EMBEDDING_API_KEY=sk-your-volcengine-key
EMBEDDING_MODEL=doubao-embedding
EMBEDDING_DIMENSIONS=2048

# ---------- Chat / LLM (火山方舟 agent plan) ----------
CHAT_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
CHAT_API_KEY=sk-your-volcengine-key
CHAT_MODEL=ark-code-latest
CHAT_MAX_RETRIES=3
CHAT_STREAM=1

# ---------- Rerank (硅基流动) ----------
RERANK_BASE_URL=https://api.siliconflow.cn/v1/rerank
RERANK_API_KEY=sk-your-siliconflow-key
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ---------- JWT ----------
JWT_SECRET=change-me-openssl-rand-base64-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080           # 7 天

# ---------- LLM 缓存 ----------
LLM_CACHE_SIZE=1000
LLM_CACHE_TTL=3600

# ---------- 幂等 + 限流 ----------
IDEMPOTENCY_TTL=86400                       # 24h
RATE_LIMIT=100

# ---------- 安全 + 监控 ----------
ENABLE_INPUT_FILTER=1
ENABLE_DOMAIN_BOUNDARY_CHECK=1
ENABLE_AUDIT_LOG=1
ENABLE_METRICS=1
METRICS_PORT=9090

# ---------- 模型网关 (熔断) ----------
MODEL_GATEWAY_CB_THRESHOLD=5
MODEL_GATEWAY_CB_TIMEOUT=60

# ---------- 归档 (冷热分离) ----------
ARCHIVE_DAYS=180
ARCHIVE_INTERVAL_HOURS=24

# ---------- 临时目录 ----------
TMPDIR=E:/cache/tmp
PIP_CACHE_DIR=E:/cache/pip
PYTHONIOENCODING=utf-8
