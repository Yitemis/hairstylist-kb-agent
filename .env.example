# ============================================
# 必备配置 (启动前必填)
# ============================================

# JWT 强校验 (≥32 字符, 含字母+数字+特殊)
JWT_SECRET=change-me-openssl-rand-base64-32

# 火山方舟 (LLM + multimodal embedding)
# https://www.volcengine.com/product/ark
CHAT_API_KEY=ark-your-chat-api-key
CHAT_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
CHAT_MODEL=ark-code-latest

# 硅基流动 (text embedding + rerank, 免费)
# https://siliconflow.cn
EMBEDDING_API_KEY=sk-your-siliconflow-key
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1/embeddings
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_DIMENSIONS=1024

# 多模态 embedding (火山方舟 multimodal 端点, 欠费时设 0 禁用)
MM_EMBEDDING_ENABLED=0
TEXT_EMBEDDING_API_KEY=sk-your-siliconflow-key
TEXT_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1/embeddings
TEXT_EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
TEXT_EMBEDDING_DIMENSIONS=1024

RERANK_API_KEY=sk-your-siliconflow-key
RERANK_BASE_URL=https://api.siliconflow.cn/v1/rerank
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ============================================
# 基础设施
# ============================================

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://hair:hair123@localhost:5432/hairstylist

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_METRIC_TYPE=COSINE
MILVUS_TOKEN=
MILVUS_URI=localhost:19530

# Redis
REDIS_URL=redis://localhost:6379/0

# ============================================
# 业务开关
# ============================================

# 安全
ENABLE_INPUT_FILTER=1
ENABLE_DOMAIN_BOUNDARY_CHECK=1
ENABLE_AUDIT_LOG=1
ENABLE_METRICS=1

# LLM
CHAT_STREAM=1
CHAT_MAX_RETRIES=3
LLM_CACHE_TTL=3600
LLM_CACHE_SIZE=1000
MODEL_GATEWAY_CB_THRESHOLD=5
MODEL_GATEWAY_CB_TIMEOUT=60
IDEMPOTENCY_TTL=86400

# HTTP
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
CORS_ORIGINS=*
RATE_LIMIT=100

# 认证
ACCESS_TOKEN_EXPIRE_MINUTES=10080
JWT_ALGORITHM=HS256

# 业务
AGENT_STATE_BACKEND=file
AGENT_STATE_ROOT=./data/agent_state

# 归档
ARCHIVE_DAYS=180
ARCHIVE_INTERVAL_HOURS=24
LOG_RETENTION_DAYS=30
METRICS_PORT=9090

# 缓存
REDIS_CACHE_PREFIX=hairstylist

# 临时 (E 盘缓存, 避免占 C 盘)
TMPDIR=E:/cache/tmp
PIP_CACHE_DIR=E:/cache/pip

# 工具
ENV=dev
VECTOR_STORE_ENGINE=milvus
VECTOR_STORE_HOST=localhost
VECTOR_STORE_PORT=19530
VECTOR_STORE_URI=localhost:19530
VECTOR_STORE_API_KEY=
