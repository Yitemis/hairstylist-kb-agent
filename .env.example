# =============================================================================
# 美发智能助手 - 环境变量配置示例
# 复制此文件为 .env 并填入实际值
# =============================================================================

# 服务器配置
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
ENV=dev  # dev | production
CORS_ORIGINS=*

# JWT 鉴权
JWT_SECRET=please-change-me-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 天

# 聊天模型（火山方舟 OpenAI 兼容）
CHAT_API_KEY=your-volcengine-api-key
CHAT_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
CHAT_MODEL=doubao-pro-32k
CHAT_STREAM=false
CHAT_MAX_RETRIES=3

# Embedding 模型（火山方舟）
EMBEDDING_API_KEY=your-volcengine-api-key
EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
EMBEDDING_MODEL=doubao-embedding-vision-250615
EMBEDDING_DIMENSIONS=2048

# Rerank 模型（可选）
RERANK_API_KEY=your-volcengine-api-key
RERANK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
RERANK_MODEL=gte-rerank

# 向量库
VECTOR_STORE_ENGINE=qdrant-local  # milvus | qdrant-local
VECTOR_STORE_HOST=localhost
VECTOR_STORE_PORT=19530
VECTOR_STORE_URI=
VECTOR_STORE_API_KEY=
VECTOR_COLLECTION=hairstylist_kb
VECTOR_DIMS=2048

# 数据库
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# 生产环境用 MySQL：mysql+aiomysql://user:pass@host:3306/db

# Agent 状态存储
AGENT_STATE_BACKEND=json_file  # json_file | memory
AGENT_STATE_ROOT=./data/agent_state

# 安全
ENABLE_INPUT_FILTER=true
ENABLE_DOMAIN_BOUNDARY_CHECK=false
RATE_LIMIT=120/minute
