# ============================================================
# 模型配置模板 —— 复制本文件为 .env 并填入真实值
# ============================================================
# ⚠️ 本文件是模板，会被提交到 Git，请勿填入真实密钥！
#    真实密钥只填在 .env 里（已被 .gitignore 保护）。
# 说明：本项目采用“模型可插拔”设计，通过 OpenAI 兼容接口接入火山方舟。

# --- Chat 对话模型（火山方舟，OpenAI 兼容） ---
CHAT_API_KEY=your_volcengine_ark_api_key_here
CHAT_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
CHAT_MODEL=ark-code-latest

# --- Embedding 嵌入模型（RAG 必需） ---
# 使用火山方舟 doubao-embedding-vision 多模态模型，
# 通过自定义适配器 app/embedding/ArkVisionEmbeddingModel 接入。
# 注意：
#   1) BASE_URL 需填完整的 multimodal 端点
#   2) DIMENSIONS 必须为 2048（doubao-embedding-vision 的真实维度）
EMBEDDING_API_KEY=your_volcengine_ark_api_key_here
EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/embeddings/multimodal
EMBEDDING_MODEL=your_embedding_endpoint_id_here
EMBEDDING_DIMENSIONS=2048

# --- Rerank 重排模型（技术亮点，型号待选型） ---
RERANK_API_KEY=
RERANK_BASE_URL=
RERANK_MODEL=

# --- 向量库（Qdrant，纯 Python 嵌入式模式，零 Docker） ---
# 模式：local=本地持久化（SQLite 文件，默认）；memory=纯内存（测试）；remote=远程服务
QDRANT_MODE=local
# 本地模式：数据文件路径
QDRANT_PATH=data/qdrant
# 远程模式：服务地址与 API key
QDRANT_URL=
QDRANT_API_KEY=
# 集合名与距离度量（COSINE / IP / L2）
VECTOR_COLLECTION=hairstylist_kb
QDRANT_METRIC_TYPE=COSINE

