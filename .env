# ============================================================
# 模型配置模板 —— 复制本文件为 .env 并填入真实值
# ============================================================
# 说明：本项目采用“模型可插拔”设计，通过 OpenAI 兼容接口接入火山方舟。
#      具体型号待你在火山方舟控制台确认后填写。

# --- Chat 对话模型（火山方舟，OpenAI 兼容） ---
CHAT_API_KEY=ark-7feed9ad-f0ab-406f-8d73-3077af4ee219-df864
CHAT_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
CHAT_MODEL=ark-code-latest

# --- Embedding 嵌入模型（RAG 必需） ---
EMBEDDING_API_KEY="ark-cf7bb075-3a77-477b-ada7-ba916ccbb089-5bee9"
EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/embeddings/multimodal
EMBEDDING_MODEL=ep-20260617140935-hcksj
EMBEDDING_DIMENSIONS=2048

# --- Rerank 重排模型（技术亮点，型号待选型） ---
RERANK_API_KEY=sk-ajfoxaheifvhzcmrkbscpoaempfjelidfgxnjtpqivulhvei
RERANK_BASE_URL=https://api.siliconflow.cn/v1/rerank
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# --- 向量库（Milvus） ---
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
VECTOR_COLLECTION=hairstylist_kb
MILVUS_METRIC_TYPE=COSINE
PIP_CACHE_DIR=E:\pip-cache
PYTHONIOENCODING=utf-8

# 纯文本 embedding (硅基流动 BAAI - 免费)
TEXT_EMBEDDING_API_KEY=sk-ajfoxaheifvhzcmrkbscpoaempfjelidfgxnjtpqivulhvei
TEXT_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1/embeddings
TEXT_EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
TEXT_EMBEDDING_DIMENSIONS=1024
MM_EMBEDDING_ENABLED=0

JWT_SECRET=khh8sPBN_45Ug8WTwmbY6OM21xrmxuOyNzmIilhJ-BM
DATABASE_URL=postgresql+asyncpg://hair:hair123@localhost:5432/hairstylist
REDIS_URL=redis://localhost:6379/0
TEXT_EMBEDDING_DIMENSIONS=1024
VECTOR_DIMS=1024
